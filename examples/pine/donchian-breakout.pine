//@version=5
// Original example for hlp (MIT). Donchian channel breakout (turtle style):
// enter on a new N-bar high/low, exit on the shorter opposite channel.
//   hlp backtest examples/pine/donchian-breakout.pine --coin BTC --interval 4h
strategy("Donchian Breakout", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

entryLen = input.int(20, "Entry channel")
exitLen  = input.int(10, "Exit channel")

upper = ta.highest(high, entryLen)[1]
lower = ta.lowest(low, entryLen)[1]
exitLong  = ta.lowest(low, exitLen)[1]
exitShort = ta.highest(high, exitLen)[1]

if close > upper
    strategy.entry("Breakout L", strategy.long)
if close < lower
    strategy.entry("Breakout S", strategy.short)

if strategy.position_size > 0 and close < exitLong
    strategy.close("Breakout L", comment="Channel exit")
if strategy.position_size < 0 and close > exitShort
    strategy.close("Breakout S", comment="Channel exit")

plot(upper, "Upper", color=color.teal)
plot(lower, "Lower", color=color.red)
