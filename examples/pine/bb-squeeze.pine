//@version=5
// Original example for hlp (MIT). Bollinger squeeze: wait until the bands are
// the narrowest in `lookback` bars, then trade the breakout out of the
// squeeze with a take-profit and stop set in ticks from the entry.
//   hlp backtest examples/pine/bb-squeeze.pine --coin SOL --interval 1h
strategy("BB Squeeze", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

len      = input.int(20, "BB length")
mult     = input.float(2.0, "BB mult")
lookback = input.int(50, "Squeeze lookback")
tpPct    = input.float(3.0, "Take profit %")
slPct    = input.float(1.5, "Stop %")

[basis, upper, lower] = ta.bb(close, len, mult)
width = (upper - lower) / basis
squeezed = width <= ta.lowest(width, lookback)
var bool armed = false
if squeezed
    armed := true

longBreak  = armed and close > upper
shortBreak = armed and close < lower

if longBreak
    strategy.entry("Squeeze L", strategy.long)
    armed := false
if shortBreak
    strategy.entry("Squeeze S", strategy.short)
    armed := false

if strategy.position_size != 0
    ticksTP = strategy.position_avg_price * tpPct / 100 / syminfo.mintick
    ticksSL = strategy.position_avg_price * slPct / 100 / syminfo.mintick
    strategy.exit("TP/SL", profit=ticksTP, loss=ticksSL)

plot(basis, "Basis", color=color.orange)
plot(upper, "Upper", color=color.gray)
plot(lower, "Lower", color=color.gray)
