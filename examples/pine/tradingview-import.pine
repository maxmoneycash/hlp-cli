//@version=6
// Original example for hlp (MIT), written the way strategies exported from
// TradingView's Pine Editor usually look: grouped inputs, a helper
// function, `var` state, a volatility-sized bracket exit and a log line.
// Paste your own script the same way:
//   hlp pine check my-strategy.pine        # lists unsupported features with line:col
//   hlp backtest my-strategy.pine --coin BTC --interval 1h
strategy(title = "Trend Pullback (TV import)", shorttitle = "TrendPB", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100, pyramiding = 0, commission_type = strategy.commission.percent,
     commission_value = 0.045)

// ── Inputs ───────────────────────────────────────────────
grpT    = "Trend"
fastLen = input.int(21, "Fast EMA", minval = 1, group = grpT)
slowLen = input.int(55, "Slow EMA", minval = 1, group = grpT)
src     = input.source(close, "Source", group = grpT)

grpR     = "Risk"
atrLen   = input.int(14, "ATR length", group = grpR)
stopATR  = input.float(2.0, "Stop (x ATR)", step = 0.25, group = grpR)
rr       = input.float(2.0, "Reward / risk", step = 0.25, group = grpR)
useShort = input.bool(true, "Allow shorts", group = grpR)

// ── Helpers ──────────────────────────────────────────────
pullback(fast, slow, dirUp) =>
    dirUp ? low <= fast and close > fast and fast > slow : high >= fast and close < fast and fast < slow

// ── Signals ──────────────────────────────────────────────
float fast = ta.ema(src, fastLen)
float slow = ta.ema(src, slowLen)
float atr  = ta.atr(atrLen)

var int trendDir = 0
trendDir := fast > slow ? 1 : fast < slow ? -1 : trendDir

longSetup  = trendDir == 1 and pullback(fast, slow, true)
shortSetup = useShort and trendDir == -1 and pullback(fast, slow, false)

if longSetup and strategy.position_size <= 0
    strategy.entry("PB Long", strategy.long)
    log.info("long setup at {0}, atr {1}", close, atr)
if shortSetup and strategy.position_size >= 0
    strategy.entry("PB Short", strategy.short)

// ATR bracket around the live position
if strategy.position_size > 0
    entry = strategy.position_avg_price
    strategy.exit("PB Long exit", from_entry = "PB Long", stop = entry - stopATR * atr, limit = entry + rr * stopATR * atr)
else if strategy.position_size < 0
    entry = strategy.position_avg_price
    strategy.exit("PB Short exit", from_entry = "PB Short", stop = entry + stopATR * atr, limit = entry - rr * stopATR * atr)

plot(fast, "Fast EMA", color = color.new(color.teal, 0), linewidth = 2)
plot(slow, "Slow EMA", color = color.new(color.orange, 0), linewidth = 2)
plotshape(longSetup, "Long setup", shape.triangleup, location.belowbar, color.teal)
plotshape(shortSetup, "Short setup", shape.triangledown, location.abovebar, color.red)
