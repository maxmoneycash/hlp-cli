//@version=6
// hlp research sample 02 (MIT, written for hlp). MACD stop-and-reverse:
// long when the MACD line crosses above its signal line (the histogram turns
// positive), short when it crosses below, sized as a fixed cash amount.
strategy("MACD signal flip", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.cash, default_qty_value = 5000)

fastLength = input.int(12, "Fast length")
slowLength = input.int(26, "Slow length")
signalLen  = input.int(9, "Signal length")

[macdLine, signalLine, hist] = ta.macd(close, fastLength, slowLength, signalLen)

if ta.crossover(hist, 0)
    strategy.entry("Bull", strategy.long)
if ta.crossunder(hist, 0)
    strategy.entry("Bear", strategy.short)

plot(strategy.equity, "Equity", color.new(color.gray, 60), display = display.data_window)
