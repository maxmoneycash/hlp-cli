//@version=5
// hlp research sample 08 (clean-room, MIT). EMA-trend entries protected by
// a broker-side trailing stop (strategy.exit trail_points / trail_offset)
// plus a fixed take-profit in ticks, as in many popular "ATR trailing stop"
// strategies. Trailing exits are OUTSIDE hlp's P0 subset; the manual
// var-based trail in 09/06 is the supported equivalent.
strategy("EMA trend + trailing stop", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

emaLen   = input.int(50, "Trend EMA")
atrLen   = input.int(14, "ATR length")
trailAtr = input.float(1.5, "Trail activation (x ATR)")
offAtr   = input.float(1.0, "Trail offset (x ATR)")
tpAtr    = input.float(4.0, "Take profit (x ATR)")

e   = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
toTicks(x) => math.round(x / syminfo.mintick)

if ta.crossover(close, e)
    strategy.entry("L", strategy.long)
if ta.crossunder(close, e)
    strategy.entry("S", strategy.short)

strategy.exit("L x", "L", profit = toTicks(tpAtr * atr), trail_points = toTicks(trailAtr * atr), trail_offset = toTicks(offAtr * atr))
strategy.exit("S x", "S", profit = toTicks(tpAtr * atr), trail_points = toTicks(trailAtr * atr), trail_offset = toTicks(offAtr * atr))

plot(e, "EMA", color.orange)
